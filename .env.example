# Copy to .env and set a unique random value before a non-local deployment.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///phishguard.sqlite
COOKIE_SECURE=false
# Optional: PHISHGUARD_MODEL_PATH=instance/url_model.joblib
# Optional rate-limit backend for multi-process deployment (for example Redis).
# RATELIMIT_STORAGE_URI=memory://
